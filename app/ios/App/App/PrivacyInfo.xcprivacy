<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>
	<!-- Nothing is collected: push-up counting runs entirely on-device from the
	     camera feed, is never recorded or transmitted (see
	     NSCameraUsageDescription in Info.plist), and the app has no backend. -->
	<key>NSPrivacyCollectedDataTypes</key>
	<array/>
	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<!-- CA92.1: access info that is only accessible to the app
				     itself. Every UserDefaults key this app's own code (not a
				     Capacitor plugin) reads/writes is app-private - alarm
				     schedule state, not shared via an App Group. -->
				<string>CA92.1</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
