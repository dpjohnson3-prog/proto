<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Lets the alarm's notifications use interruptionLevel .timeSensitive,
	     which breaks through most Focus modes. Self-serve: unlike Critical
	     Alerts it needs no approval from Apple, but it DOES need this
	     entitlement plus the matching capability on the provisioning profile.

	     Background audio deliberately has no entry here: UIBackgroundModes in
	     Info.plist is all it needs.

	     AlarmKit (DawnAlarmKit.swift) also has no entry here - checked against
	     the actual installed SDK's bundled resources, nothing requiring an
	     entitlement or Signing & Capabilities toggle turned up anywhere.
	     NSAlarmKitUsageDescription in Info.plist plus the runtime
	     requestAuthorization() call is everything it needs. -->
	<key>com.apple.developer.usernotifications.time-sensitive</key>
	<true/>
</dict>
</plist>
