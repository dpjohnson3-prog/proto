{"sCal": "  <section class=\"screen\" id=\"sCal\">\n    <h1 id=\"calTitle\">Do two slow push-ups</h1>\n    <p class=\"lede\" id=\"calLede\">Go all the way down and all the way up. Take your time \u2014 this is just so it can see your range.</p>\n    <div class=\"count\" id=\"calTimer\">6</div>\n    <div class=\"countSub\">seconds left</div>\n    <div class=\"scope\">\n      <div class=\"scopeHead\"><span>What the camera sees</span><span class=\"state\" id=\"calState\">watching</span></div>\n      <canvas id=\"traceCal\" width=\"600\" height=\"168\"></canvas>\n    </div>\n    <div class=\"escape\"><button class=\"quiet\" id=\"skipCal\">Skip this and use a timer instead</button></div>\n  </section>", "sCount": "  <section class=\"screen\" id=\"sCount\">\n    <div class=\"count\" id=\"countVal\">0</div>\n    <div class=\"countSub\" id=\"countSub\">of 10</div>\n\n    <div class=\"scope\">\n      <div class=\"scopeHead\"><span>What the camera sees</span><span class=\"state\" id=\"liveState\">up</span></div>\n      <canvas id=\"trace\" width=\"600\" height=\"168\"></canvas>\n    </div>\n\n    <div class=\"warn hide\" id=\"stallWarn\">\n      Not picking up much movement. Move your phone back so more of your body is in frame, or tap below to switch.\n    </div>\n\n    <div class=\"escape\">\n      <button class=\"quiet\" id=\"notWorking\">It's not counting me</button>\n    </div>\n  </section>", "sDone": "  <section class=\"screen\" id=\"sDone\">\n    <div class=\"done warm\">\n      <div class=\"big\" id=\"doneBig\">Alarm off.</div>\n      <p id=\"doneSub\">You're up.</p>\n    </div>\n    <div style=\"margin-top:auto\">\n      <button id=\"againBtn\">Run it again</button>\n    </div>\n  </section>", "sheet": "<div class=\"sheet\" id=\"sheet\" role=\"dialog\" aria-modal=\"true\" aria-labelledby=\"sheetTitle\">\n  <h2 id=\"sheetTitle\">Let's get you out of this</h2>\n  <p>You should never be stuck doing reps a broken counter won't accept.</p>\n  <button id=\"recal\">Recalibrate \u2014 I'll do two more slow reps</button>\n  <button class=\"ghost\" id=\"toTimer\">Switch to a 30-second hold instead</button>\n  <button class=\"ghost\" id=\"bail\">Just turn the alarm off</button>\n  <button class=\"quiet\" id=\"closeSheet\">Go back</button>\n</div>", "dbg": "<div id=\"dbg\" aria-hidden=\"true\">\n  <div><span class=\"k\">n </span><b id=\"dN\">-</b><span class=\"k\"> phase </span><b id=\"dPhase\">-</b></div>\n  <div id=\"dbgBar\"><i id=\"dbgMark\"></i></div>\n  <div><span class=\"k\">lo </span><b id=\"dLo\">-</b><span class=\"k\"> hi </span><b id=\"dHi\">-</b></div>\n  <div><span class=\"k\">range </span><b id=\"dRange\">-</b><span class=\"k\"> cal </span><b id=\"dCal\">-</b></div>\n  <div><span class=\"k\">floor </span><b id=\"dFloor\">-</b><span class=\"k\"> raw </span><b id=\"dRaw\">-</b></div>\n  <div><span class=\"k\">swing </span><b id=\"dSwing\">-</b></div>\n  <div><span class=\"k\">reps </span><b id=\"dReps\">-</b><span class=\"k\"> rej </span><b id=\"dRej\">-</b><span class=\"k\"> fps </span><b id=\"dFps\">-</b></div>\n</div>"}